# Copied to .env by `task setup`. Never commit .env.

DATABASE_URL=postgresql+psycopg://ginantaka:ginantaka@localhost:5432/ginantaka_shoes
# Tests only. Each test runs in a rolled-back transaction.
TEST_DATABASE_URL=postgresql+psycopg://ginantaka:ginantaka@localhost:5432/ginantaka_shoes_test

# Change this outside local development.
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Cloudflare R2 (ADR 0004). Needed from Phase 2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ginantaka-shoes-dev
PUBLIC_ASSET_BASE_URL=

# `console` prints emails to the API log.
EMAIL_BACKEND=console

# Used by `task api:seed-owner` (CMD-1).
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please
OWNER_NAME=Owner
